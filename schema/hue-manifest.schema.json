{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kyannic52/moodle-mod_kopfuebung/schema/hue-manifest.schema.json",
  "title": "HUE 1.0 manifest",
  "description": "Manifest for the Hausuebung Exchange Format.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "format_version",
    "package_id",
    "language",
    "activity",
    "questions"
  ],
  "properties": {
    "format": {
      "const": "HUE"
    },
    "format_version": {
      "const": "1.0"
    },
    "package_id": {
      "$ref": "#/$defs/uuid"
    },
    "language": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "activity": {
      "$ref": "#/$defs/activity"
    },
    "questions": {
      "type": "array",
      "minItems": 8,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/questionReference"
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "activity": {
            "properties": {
              "question_count": {"const": 8}
            },
            "required": ["question_count"]
          }
        }
      },
      "then": {
        "properties": {
          "questions": {"minItems": 8, "maxItems": 8}
        }
      }
    },
    {
      "if": {
        "properties": {
          "activity": {
            "properties": {
              "question_count": {"const": 9}
            },
            "required": ["question_count"]
          }
        }
      },
      "then": {
        "properties": {
          "questions": {"minItems": 9, "maxItems": 9}
        }
      }
    },
    {
      "if": {
        "properties": {
          "activity": {
            "properties": {
              "question_count": {"const": 10}
            },
            "required": ["question_count"]
          }
        }
      },
      "then": {
        "properties": {
          "questions": {"minItems": 10, "maxItems": 10}
        }
      }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "formattedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "text"],
      "properties": {
        "format": {
          "enum": ["html", "moodle", "plain", "markdown"]
        },
        "text": {
          "type": "string"
        }
      }
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "time_limit_seconds",
        "question_count",
        "self_assessment",
        "difficulty_assessment",
        "allow_ready_withdrawal"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "description": {
          "$ref": "#/$defs/formattedText"
        },
        "time_limit_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "question_count": {
          "enum": [8, 9, 10]
        },
        "self_assessment": {
          "type": "boolean"
        },
        "difficulty_assessment": {
          "type": "boolean"
        },
        "allow_ready_withdrawal": {
          "type": "boolean"
        }
      }
    },
    "questionReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "position", "xml_index", "fingerprint"],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "position": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "xml_index": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
